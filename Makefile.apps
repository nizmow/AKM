	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) $(MGCOPY_INCLUDES) \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

