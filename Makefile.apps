CROSS_COMPILE ?= m68k-atari-mintelf-
CC := $(CROSS_COMPILE)gcc
VASM ?= vasmm68k_mot
STRIP ?= $(CROSS_COMPILE)strip
BUILD_DIR ?= build/atari/apps
CFLAGS ?= -O2 -g -Wall -Wextra
# Applications use the supplied MiNTLib's default stack ABI and 32-bit int.
# Do not inherit the kernel's -mshort/-mfastcall flags or Pure C libraries.
APP_FLAGS := -std=gnu11 -m68000
.DEFAULT_GOAL := all

APPLICAT_DIR := MagiC/APPS/APPLICAT/SRC
APPLICAT_SOURCES := $(addprefix $(APPLICAT_DIR)/,APPLICAT.C ICONSEL.C ICA_DIAL.C \
  ANW_DIAL.C TYP_DIAL.C ICP_DIAL.C PTH_DIAL.C SPC_DIAL.C READ_INF.C INF.C \
  WINDOWS.C IMPORT/GEMUT_MT.C)
APPLICAT_OBJECTS := $(patsubst $(APPLICAT_DIR)/%.C,$(BUILD_DIR)/applicat/%.o,$(APPLICAT_SOURCES))
MGVIEW_DIR := MagiC/APPS/MGVIEW/SRC
MGVIEW_SOURCES := $(addprefix $(MGVIEW_DIR)/,MGVIEW.C WINDOWS.C MGWIND.C MEMCHAR2.C)
MGVIEW_OBJECTS := $(patsubst $(MGVIEW_DIR)/%.C,$(BUILD_DIR)/mgview/%.o,$(MGVIEW_SOURCES))
MGNOTICE_DIR := MagiC/APPS/MGNOTICE.2/SRC
MGNOTICE_GEMUT_DIR := MagiC/APPS/APPLICAT/SRC/IMPORT
MGNOTICE_SOURCES := $(addprefix $(MGNOTICE_DIR)/,MGNOTICE.C MGNWIND.C \
  OPT_DIAL.C WINDOWS.C)
MGNOTICE_OBJECTS := $(patsubst $(MGNOTICE_DIR)/%.C,$(BUILD_DIR)/mgnotice/%.o,$(MGNOTICE_SOURCES))
MGSEARCH_DIR := MagiC/APPS/MGSEARCH/SRC
MGSEARCH_MYLIBS_DIR := MagiC/LIB/MYLIBS/SRC
MGSEARCH_PATTERN_DIR := $(MGSEARCH_DIR)
MGSEARCH_INCLUDES := -I"$(MGSEARCH_DIR)" -I"$(MGSEARCH_MYLIBS_DIR)" \
  -I"$(MGSEARCH_PATTERN_DIR)"
MGSEARCH_SOURCES := $(addprefix $(MGSEARCH_DIR)/,MGSEARCH.C SEARCH.C SRCH_WIN.C)
MGSEARCH_OBJECTS := $(patsubst $(MGSEARCH_DIR)/%.C,$(BUILD_DIR)/mgsearch/%.o,$(MGSEARCH_SOURCES)) \
  $(BUILD_DIR)/mgsearch/GEMUTILS.o $(BUILD_DIR)/mgsearch/WINDOWS.o \
  $(BUILD_DIR)/mgsearch/PATTERN.o

MAGXDESK_DIR := MagiC/APPS/MAGICDESK/MAGXDESK.5
MAGXDESK_SOURCES := $(addprefix $(MAGXDESK_DIR)/,MAGXDESK.C SPEC.C \
  DEFAULTS.C DIALOGS.C DLG_INFO.C DWINDOWS.C FILES.C IMGLOAD.C KACHEL.C \
  KLICK.C ALLG.C DMENU.C DKLICK.C PATTERN.C LL.C SHELSORT.C)
MAGXDESK_OBJECTS := $(patsubst $(MAGXDESK_DIR)/%.C,$(BUILD_DIR)/magxdesk/%.o,$(MAGXDESK_SOURCES))
MGCOPY_DIR := MagiC/APPS/MGCOPY/SRC
MGCOPY_GEMUT_DIR := MagiC/APPS/APPLICAT/SRC/IMPORT
MGCOPY_INCLUDES := -I"$(MGCOPY_DIR)" -I"$(MGCOPY_GEMUT_DIR)"
MGCOPY_SOURCES := $(addprefix $(MGCOPY_DIR)/,MGCOPY.C CPFILES.C BEG_DIAL.C DAT_DIAL.C)
MGCOPY_OBJECTS := $(patsubst $(MGCOPY_DIR)/%.C,$(BUILD_DIR)/mgcopy/%.o,$(MGCOPY_SOURCES)) \
  $(BUILD_DIR)/mgcopy/GEMUT_MT.o
MGFORMAT_DIR := MagiC/APPS/MGFORMAT/SRC
MGFORMAT_GEMUT_DIR := MagiC/APPS/APPLICAT/SRC/IMPORT
MGFORMAT_INCLUDES := -I"$(MGFORMAT_DIR)" -I"$(MGFORMAT_GEMUT_DIR)"
MGFORMAT_SOURCES := $(addprefix $(MGFORMAT_DIR)/,MGFORMAT.C FMT_DIAL.C CPY_DIAL.C FORMAT.C MGFORMAT_WDLG.C)
MGFORMAT_OBJECTS := $(patsubst $(MGFORMAT_DIR)/%.C,$(BUILD_DIR)/mgformat/%.o,$(MGFORMAT_SOURCES)) \
  $(BUILD_DIR)/mgformat/GEMUT_MT.o
VT52_DIR := MagiC/APPS/VT52/SRC/VT52
VT52_INCLUDE_DIR := MagiC/APPS/VT52/SRC/INCLUDE
VT52_RESOURCE_DIR := $(VT52_DIR)/RESOURCE/DEUTSCH
VT52_DRAGDROP_DIR := MagiC/APPS/VT52/SRC/LIB/QUELLEN/DRAGDROP
VT52_INCLUDES := -I"$(VT52_DIR)" -I"$(VT52_INCLUDE_DIR)" -I"$(VT52_RESOURCE_DIR)"
VT52_SOURCES := $(addprefix $(VT52_DIR)/,VT_MENU.C VT_EMU.C WLIB.C LIST_NEW.C)
VT52_ASM_SOURCES := $(addprefix $(VT52_DIR)/,VT_AES.S VT_VDI.S VT_BIOS.S \
  VT_XBIOS.S VT_BELL.S VT_SEM.S VT_MOVE.S VT_ETERM.S)
VT52_OBJECTS := $(patsubst $(VT52_DIR)/%.C,$(BUILD_DIR)/vt52/%.o,$(VT52_SOURCES)) \
  $(patsubst $(VT52_DIR)/%.S,$(BUILD_DIR)/vt52/%.o,$(VT52_ASM_SOURCES)) \
  $(BUILD_DIR)/vt52/DRAGDROP.o

COPS_DIR := MagiC/APPS/COPS
COPS_SOURCES := $(addprefix $(COPS_DIR)/,COPS.C CALLBACK.C CPX_BIND.C \
  ADAPTRSC.C FIX_RSC.C LIST.C PHSTUFF.C POPUP.C RC_INTER.C WLIB.C COPS_RSC.C)
COPS_OBJECTS := $(patsubst $(COPS_DIR)/%.C,$(BUILD_DIR)/cops/%.o,$(COPS_SOURCES))
COPS_ASM_OBJECTS := $(BUILD_DIR)/cops/CLEARCPU.o
COPS_ASM_NORMALIZED := $(BUILD_DIR)/cops/CLEARCPU.s
COPS_OUTPUT_DIR := $(abspath $(BUILD_DIR)/cops)
COPS_SOURCE_DIR := $(abspath $(COPS_DIR))
COPS_OUTPUT_LOWER := $(shell printf '%s' '$(COPS_OUTPUT_DIR)' | tr '[:upper:]' '[:lower:]')
COPS_SOURCE_LOWER := $(shell printf '%s' '$(COPS_SOURCE_DIR)' | tr '[:upper:]' '[:lower:]')
ifeq ($(COPS_OUTPUT_LOWER),$(COPS_SOURCE_LOWER))
$(error BUILD_DIR=$(BUILD_DIR) aliases the COPS source directory)
endif

MCMD_DIR := MagiC/APPS/CMD/SRC
MCMD_LANG ?= de
MAS_NORMALIZER := MagiC/KERNEL/BUILD/GCC/mas_to_vasm.py

# First standalone OSD port. The archived MIN-ATARI binary is the structural
# reference: it is the same V4.10 source and must match byte-for-byte.
OSD002_DIR := MagiC/KERNEL/VDI/SRC/MAGIC.DRV/OSD
OSD_INCLUDE_DIR := MagiC/KERNEL/VDI/SRC/MAGICVDI.2/INCLUDE
OSD002_SOURCE := $(OSD002_DIR)/OFF002.S
OSD002_NORMALIZED := $(BUILD_DIR)/osd/src/OFF002.S
OSD002_INCLUDES := $(addprefix $(BUILD_DIR)/osd/src/,\
  LINEA.I TOS.I SEEDFILL.I NVDI_WK.I VDI.I DRIVER.I)
OSD002_OUTPUT := $(BUILD_DIR)/osd/OFF002.OSD

MCMD_SOURCES := $(wildcard $(MCMD_DIR)/*.S $(MCMD_DIR)/*.INC $(MCMD_DIR)/INTERN/*.S)
MCMD_NORMALIZED := $(addprefix $(BUILD_DIR)/mcmd/src/,$(notdir $(MCMD_SOURCES)))

$(BUILD_DIR)/osd/src/%.I: $(OSD_INCLUDE_DIR)/%.I $(MAS_NORMALIZER) Makefile.apps
	mkdir -p "$(@D)"
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(OSD002_NORMALIZED): $(OSD002_SOURCE) $(MAS_NORMALIZER) Makefile.apps
	mkdir -p "$(@D)"
	python3 $(MAS_NORMALIZER) "$<" "$@"

# -nosym drops VASM's symbol table (the archived TOS header has slen=0).
# -tos-flags=7 preserves the archived TOS header's stack/absolute flags.
$(OSD002_OUTPUT): $(OSD002_NORMALIZED) $(OSD002_INCLUDES) Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Ftos -m68000 -noesc -nosym -tos-flags=7 \
	  -I"$(BUILD_DIR)/osd/src/" -o "$@" "$(OSD002_NORMALIZED)"

.PHONY: off002 off002-test-driver
off002: $(OSD002_OUTPUT)
off002-test-driver: $(BUILD_DIR)/off002/OFF002.PRG

$(BUILD_DIR)/off002/OFF002.PRG: MagiC/KERNEL/VDI/TESTDATA/OFF002.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

# Same V4.10 source family as OFF002, with a 4-colour/2-plane header. The
# MIN-ATARI archive is the byte reference; the Release driver is V4.11.
OSD004IP_NORMALIZED := $(BUILD_DIR)/osd/src/OFF004IP.S
OSD004IP_OUTPUT := $(BUILD_DIR)/osd/OFF004IP.OSD

$(OSD004IP_NORMALIZED): $(OSD002_DIR)/OFF004IP.S $(MAS_NORMALIZER) Makefile.apps
	mkdir -p "$(@D)"
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(OSD004IP_OUTPUT): $(OSD004IP_NORMALIZED) $(OSD002_INCLUDES) Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Ftos -m68000 -noesc -nosym -tos-flags=7 -no-opt \
	  -I"$(BUILD_DIR)/osd/src/" -o "$@" "$(OSD004IP_NORMALIZED)"

.PHONY: off004ip off004ip-test-driver
off004ip: $(OSD004IP_OUTPUT)
off004ip-test-driver: $(BUILD_DIR)/off004ip/OFF004IP.PRG

$(BUILD_DIR)/off004ip/OFF004IP.PRG: MagiC/KERNEL/VDI/TESTDATA/OFF004IP.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

# 16-colour, 4-plane interleaved offscreen driver from the same source family.
OSD016IP_NORMALIZED := $(BUILD_DIR)/osd/src/OFF016IP.S
OSD016IP_OUTPUT := $(BUILD_DIR)/osd/OFF016IP.OSD

$(OSD016IP_NORMALIZED): $(OSD002_DIR)/OFF016IP.S $(MAS_NORMALIZER) Makefile.apps
	mkdir -p "$(@D)"
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(OSD016IP_OUTPUT): $(OSD016IP_NORMALIZED) $(OSD002_INCLUDES) Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Ftos -m68000 -noesc -nosym -tos-flags=7 -no-opt \
	  -I"$(BUILD_DIR)/osd/src/" -o "$@" "$(OSD016IP_NORMALIZED)"

.PHONY: off016ip off016ip-test-driver
off016ip: $(OSD016IP_OUTPUT)
off016ip-test-driver: $(BUILD_DIR)/off016ip/OFF016IP.PRG

$(BUILD_DIR)/off016ip/OFF016IP.PRG: MagiC/KERNEL/VDI/TESTDATA/OFF016IP.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

# 256-colour, 8-plane interleaved offscreen driver.
OSD256IP_NORMALIZED := $(BUILD_DIR)/osd/src/OFF256IP.S
OSD256IP_OUTPUT := $(BUILD_DIR)/osd/OFF256IP.OSD

$(OSD256IP_NORMALIZED): $(OSD002_DIR)/OFF256IP.S $(MAS_NORMALIZER) Makefile.apps
	mkdir -p "$(@D)"
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(OSD256IP_OUTPUT): $(OSD256IP_NORMALIZED) $(OSD002_INCLUDES) Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Ftos -m68000 -noesc -nosym -tos-flags=7 -no-opt \
	  -I"$(BUILD_DIR)/osd/src/" -o "$@" "$(OSD256IP_NORMALIZED)"

.PHONY: off256ip off256ip-test-driver
off256ip: $(OSD256IP_OUTPUT)
off256ip-test-driver: $(BUILD_DIR)/off256ip/OFF256IP.PRG

$(BUILD_DIR)/off256ip/OFF256IP.PRG: MagiC/KERNEL/VDI/TESTDATA/OFF256IP.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

# Remaining packed/direct-colour OSD drivers. Their archived references span
# different source versions, so parity is decided per target, not assumed.
OSD_BATCH_NAMES := OFF016PK OFF256PK OFF32KFL OFF32KPK OFF16MOV
OSD_BATCH_NOOPT := OFF016PK OFF32KFL OFF32KPK OFF16MOV
OSD_BATCH_NORMALIZED := $(addprefix $(BUILD_DIR)/osd/src/,$(addsuffix .S,$(OSD_BATCH_NAMES)))
OSD_BATCH_OUTPUTS := $(addprefix $(BUILD_DIR)/osd/,$(addsuffix .OSD,$(OSD_BATCH_NAMES))) \
  $(BUILD_DIR)/osd/OFF65KPK.OSD
OSD_BATCH_PROBES := $(addprefix $(BUILD_DIR)/osd-probes/,$(addsuffix .PRG,$(OSD_BATCH_NAMES))) \
  $(BUILD_DIR)/osd-probes/OFF65KPK.PRG

$(OSD_BATCH_NORMALIZED): $(BUILD_DIR)/osd/src/%.S: $(OSD002_DIR)/%.S $(MAS_NORMALIZER) Makefile.apps
	mkdir -p "$(@D)"
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(addprefix $(BUILD_DIR)/osd/,$(addsuffix .OSD,$(OSD_BATCH_NOOPT))): \
  $(BUILD_DIR)/osd/%.OSD: $(BUILD_DIR)/osd/src/%.S $(OSD002_INCLUDES) Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Ftos -m68000 -noesc -nosym -tos-flags=7 -no-opt \
	  -I"$(BUILD_DIR)/osd/src/" -o "$@" "$<"

# OFF256PK needs VASM's branch-size extension, which -no-opt disables. Its
# source (V4.11) matches neither the V3.02 archive nor the V4.12 Release.
$(BUILD_DIR)/osd/OFF256PK.OSD: $(BUILD_DIR)/osd/src/OFF256PK.S $(OSD002_INCLUDES) Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Ftos -m68000 -noesc -nosym -tos-flags=7 \
	  -I"$(BUILD_DIR)/osd/src/" -o "$@" "$<"

# OFF65KPK.S comes from a checkout whose local `include\*.inc` tree is absent;
# every other OSD source names the shared MAGICVDI.2 includes as `.I`. That
# include tree also defined the `MD_*` write-mode aliases as VDI.I's names.
$(BUILD_DIR)/osd/src/OFF65KPK.S: $(OSD002_DIR)/OFF65KPK.S $(MAS_NORMALIZER) Makefile.apps
	mkdir -p "$(@D)"
	python3 $(MAS_NORMALIZER) "$<" "$@"
	sed -i -E -e 's/\.INC"/.I"/g' -e 's/\bMD_REPLACE\b/REPLACE/g' \
	  -e 's/\bMD_XOR\b/EX_OR/g' -e 's/\bMD_ERASE\b/REV_TRANS/g' \
	  -e 's/\br_planes\b/planes/g' "$@"

$(BUILD_DIR)/osd/OFF65KPK.OSD: $(BUILD_DIR)/osd/src/OFF65KPK.S $(OSD002_INCLUDES) Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Ftos -m68000 -noesc -nosym -tos-flags=7 \
	  -I"$(BUILD_DIR)/osd/src/" -o "$@" "$<"

$(OSD_BATCH_PROBES): $(BUILD_DIR)/osd-probes/%.PRG: MagiC/KERNEL/VDI/TESTDATA/%.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

.PHONY: osd-batch off016pk off256pk off32kfl off32kpk off16mov off65kpk \
  off016pk-test-driver off256pk-test-driver off32kfl-test-driver \
  off32kpk-test-driver off16mov-test-driver off65kpk-test-driver
osd-batch: $(OSD_BATCH_OUTPUTS) $(OSD_BATCH_PROBES)
off016pk: $(BUILD_DIR)/osd/OFF016PK.OSD
off256pk: $(BUILD_DIR)/osd/OFF256PK.OSD
off32kfl: $(BUILD_DIR)/osd/OFF32KFL.OSD
off32kpk: $(BUILD_DIR)/osd/OFF32KPK.OSD
off16mov: $(BUILD_DIR)/osd/OFF16MOV.OSD
off65kpk: $(BUILD_DIR)/osd/OFF65KPK.OSD
off016pk-test-driver: $(BUILD_DIR)/osd-probes/OFF016PK.PRG
off256pk-test-driver: $(BUILD_DIR)/osd-probes/OFF256PK.PRG
off32kfl-test-driver: $(BUILD_DIR)/osd-probes/OFF32KFL.PRG
off32kpk-test-driver: $(BUILD_DIR)/osd-probes/OFF32KPK.PRG
off16mov-test-driver: $(BUILD_DIR)/osd-probes/OFF16MOV.PRG
off65kpk-test-driver: $(BUILD_DIR)/osd-probes/OFF65KPK.PRG

# MFA (Atari) and MFM (MagiCMac) screen drivers. The older MFM sources still
# name the NVDI field at offset 196 `_nvdi_PixMap_ptr`; the current include
# calls the same field `_nvdi_vdi_setup_ptr`.
SCREEN_DIR := MagiC/KERNEL/VDI/SRC/MAGIC.DRV
SCREEN_MFA_NAMES := MFA2 MFA4 MFA16 MFA256 MFA32K
SCREEN_MFM_NAMES := MFM2 MFM16 MFM16IP MFM16M MFM256 MFM32K MFM4IP
SCREEN_NAMES := $(SCREEN_MFA_NAMES) $(SCREEN_MFM_NAMES)
SCREEN_INCLUDE_NAMES := DRIVER.I HARDWARE.I LINEA.I NVDI_WK.I PIXMAP.I TOS.I VDI.I
SCREEN_INCLUDES := $(addprefix $(BUILD_DIR)/screen/src/,$(SCREEN_INCLUDE_NAMES))
SCREEN_NORMALIZED := $(addprefix $(BUILD_DIR)/screen/src/,$(addsuffix .S,$(SCREEN_NAMES)))
SCREEN_OUTPUTS := $(addprefix $(BUILD_DIR)/screen/,$(addsuffix .SYS,$(SCREEN_NAMES)))
SCREEN_MFA_OUTPUTS := $(addprefix $(BUILD_DIR)/screen/,$(addsuffix .SYS,$(SCREEN_MFA_NAMES)))
SCREEN_MFM_OUTPUTS := $(addprefix $(BUILD_DIR)/screen/,$(addsuffix .SYS,$(SCREEN_MFM_NAMES)))

$(BUILD_DIR)/screen/src/%.I: $(OSD_INCLUDE_DIR)/%.I $(MAS_NORMALIZER) Makefile.apps
	mkdir -p "$(@D)"
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(addprefix $(BUILD_DIR)/screen/src/,$(addsuffix .S,$(SCREEN_MFA_NAMES))): \
  $(BUILD_DIR)/screen/src/%.S: $(SCREEN_DIR)/MFA/%.S $(MAS_NORMALIZER) Makefile.apps
	mkdir -p "$(@D)"
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(addprefix $(BUILD_DIR)/screen/src/,$(addsuffix .S,$(SCREEN_MFM_NAMES))): \
  $(BUILD_DIR)/screen/src/%.S: $(SCREEN_DIR)/MFM/%.S $(MAS_NORMALIZER) Makefile.apps
	mkdir -p "$(@D)"
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(SCREEN_OUTPUTS): $(BUILD_DIR)/screen/%.SYS: $(BUILD_DIR)/screen/src/%.S $(SCREEN_INCLUDES) Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Ftos -m68000 -noesc -nosym -tos-flags=7 -DDUMMY=0 \
	  -D_nvdi_PixMap_ptr=196 -no-opt -opt-allbra \
	  -I"$(BUILD_DIR)/screen/src/" -o "$@" "$<"

SCREEN_PROBE := $(BUILD_DIR)/screen/SCREEN.PRG

$(SCREEN_PROBE): MagiC/KERNEL/VDI/TESTDATA/SCREEN.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS)

.PHONY: screen-drivers screen-boot-probe mfa mfm \
  mfa2 mfa4 mfa16 mfa256 mfa32k \
  mfm2 mfm16 mfm16ip mfm16m mfm256 mfm32k mfm4ip
screen-drivers: $(SCREEN_OUTPUTS)
screen-boot-probe: $(SCREEN_PROBE)
mfa: $(SCREEN_MFA_OUTPUTS)
mfm: $(SCREEN_MFM_OUTPUTS)
mfa2: $(BUILD_DIR)/screen/MFA2.SYS
mfa4: $(BUILD_DIR)/screen/MFA4.SYS
mfa16: $(BUILD_DIR)/screen/MFA16.SYS
mfa256: $(BUILD_DIR)/screen/MFA256.SYS
mfa32k: $(BUILD_DIR)/screen/MFA32K.SYS
mfm2: $(BUILD_DIR)/screen/MFM2.SYS
mfm16: $(BUILD_DIR)/screen/MFM16.SYS
mfm16ip: $(BUILD_DIR)/screen/MFM16IP.SYS
mfm16m: $(BUILD_DIR)/screen/MFM16M.SYS
mfm256: $(BUILD_DIR)/screen/MFM256.SYS
mfm32k: $(BUILD_DIR)/screen/MFM32K.SYS
mfm4ip: $(BUILD_DIR)/screen/MFM4IP.SYS

MAGXBOOT_DIR := MagiC/KERNEL/BIOS/ATARI/BOOT
MAGXBOOT_SRC := $(BUILD_DIR)/magxboot/src
MAGXBOOT_OUTPUTS := $(addprefix $(BUILD_DIR)/magxboot/,MAGXBOOT.TOS MAGXBOOT.PRG MAGXBO32.PRG)

.PHONY: magxboot
magxboot: $(MAGXBOOT_OUTPUTS)

$(MAGXBOOT_SRC)/MAGXBOOT.S: $(MAGXBOOT_DIR)/MAGXBOOT.S $(MAS_NORMALIZER) \
  NON-TOS/atari-utf8-conversion/atari-utf8.c Makefile.apps
	python3 $(MAS_NORMALIZER) --atari-strings "$<" "$@"

$(MAGXBOOT_SRC)/OSBIND.INC: MagiC/INC_AS/OSBIND.INC $(MAS_NORMALIZER) Makefile.apps
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(BUILD_DIR)/magxboot/MAGXBO32.PRG: MAGXBOOT_OUTSIDE := 1
$(BUILD_DIR)/magxboot/MAGXBOOT.TOS $(BUILD_DIR)/magxboot/MAGXBO32.PRG: \
  $(MAGXBOOT_SRC)/MAGXBOOT.S $(MAGXBOOT_SRC)/OSBIND.INC Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Ftos -m68000 -noesc -nosym -tos-flags=7 \
	  -DOUTSIDE=$(if $(MAGXBOOT_OUTSIDE),1,0) -I"$(MAGXBOOT_SRC)/" -o "$@" "$<"

# The shipped loader and the archived normal PRG have identical contents.
$(BUILD_DIR)/magxboot/MAGXBOOT.PRG: $(BUILD_DIR)/magxboot/MAGXBOOT.TOS
	cp "$<" "$@"

.PHONY: mcmd mcmd-languages mcmd-test-driver
mcmd: $(BUILD_DIR)/mcmd/$(MCMD_LANG)/MCMD.TOS
mcmd-languages: $(foreach lang,de en fr,$(BUILD_DIR)/mcmd/$(lang)/MCMD.TOS)
mcmd-test-driver: $(BUILD_DIR)/mcmd/NEOSTART.PRG $(BUILD_DIR)/mcmd/CHILD.TTP

$(BUILD_DIR)/mcmd/src/%: $(MCMD_DIR)/% $(MAS_NORMALIZER) Makefile.apps
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(BUILD_DIR)/mcmd/src/%: $(MCMD_DIR)/INTERN/% $(MAS_NORMALIZER) Makefile.apps
	python3 $(MAS_NORMALIZER) "$<" "$@"

$(BUILD_DIR)/mcmd/%/MCMD.TOS: $(MCMD_NORMALIZED) Makefile.apps
	mkdir -p "$(@D)"
	case "$*" in de) country=1;; fr) country=2;; en) country=3;; \
	  *) echo "Unsupported MCMD language: $* (use de, en or fr)" >&2; exit 1;; esac; \
	$(VASM) -Ftos -m68000 -noesc -DCOUNTRY=$$country \
	  -I"$(BUILD_DIR)/mcmd/src/" -o "$@" "$(BUILD_DIR)/mcmd/src/CMD.S"

$(BUILD_DIR)/mcmd/NEOSTART.PRG: MagiC/APPS/CMD/TESTDATA/NEOSTART.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/mcmd/CHILD.TTP: MagiC/APPS/CMD/TESTDATA/CHILD.C MagiC/APPS/TOS_ARGS.H Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.TTP=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS)

MAGXCONF_DIR := MagiC/APPS/MAGXCONF/SRC
MAGXCONF_LANG ?= de
MAGXCONF_INCLUDES := OSBIND.INC AESBIND.INC MAGIX.INC
MAGXCONF_NORMALIZED := $(addprefix $(BUILD_DIR)/magxconf/src/,$(MAGXCONF_INCLUDES)) \
  $(BUILD_DIR)/magxconf/src/MAGXCONF.S

.PHONY: magxconf magxconf-languages magxconf-test-driver
magxconf: $(BUILD_DIR)/magxconf/$(MAGXCONF_LANG)/MAGXCONF.PRG \
  $(BUILD_DIR)/magxconf/$(MAGXCONF_LANG)/MAGXCONF.ACC
magxconf-languages: $(foreach lang,de en fr,$(BUILD_DIR)/magxconf/$(lang)/MAGXCONF.PRG \
  $(BUILD_DIR)/magxconf/$(lang)/MAGXCONF.ACC)
magxconf-test-driver: $(BUILD_DIR)/magxconf/NEOSTART.PRG

$(BUILD_DIR)/magxconf/src/%.INC: MagiC/INC_AS/%.INC $(MAS_NORMALIZER) Makefile.apps
	python3 $(MAS_NORMALIZER) --atari-strings "$<" "$@"

$(BUILD_DIR)/magxconf/src/MAGXCONF.S: $(MAGXCONF_DIR)/MAGXCONF.S $(MAS_NORMALIZER) Makefile.apps
	python3 $(MAS_NORMALIZER) --atari-strings "$<" "$@"

$(BUILD_DIR)/magxconf/%/MAGXCONF.PRG: $(MAGXCONF_NORMALIZED) Makefile.apps
	mkdir -p "$(@D)"
	case "$*" in de) country=1;; fr) country=2;; en) country=3;; \
	  *) echo "Unsupported MAGXCONF language: $* (use de, en or fr)" >&2; exit 1;; esac; \
	$(VASM) -Ftos -m68000 -noesc -DCOUNTRY=$$country \
	  -I"$(BUILD_DIR)/magxconf/src/" -o "$@" "$(BUILD_DIR)/magxconf/src/MAGXCONF.S"

# The same executable detects program/accessory startup from its basepage.
$(BUILD_DIR)/magxconf/%/MAGXCONF.ACC: $(BUILD_DIR)/magxconf/%/MAGXCONF.PRG
	cp "$<" "$@"

$(BUILD_DIR)/magxconf/NEOSTART.PRG: MagiC/APPS/MAGXCONF/TESTDATA/NEOSTART.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem


.PHONY: all applicat mod-app cmdline mac2st dump fc split dis dis1 dis2 showfile limitmem limitmem-test-driver mgclock mgxclock mgxclock-test-driver vfatconf shutdown wbdaemon wbdaemon-test-driver flp-par flp-par0 flp-par1 magxconf-cpx tslice-cpx cops winframe xp-rastr load-img slbtest mod-app-test-driver mgview mgnotice mgnotice-test-driver mgsearch mgsearch-test-driver mgcopy mgcopy-test-driver mgformat mgformat-test-driver mgformat-hardware-kit vt52 vt52-test-driver magxdesk abi-check console-test-driver
