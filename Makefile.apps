CROSS_COMPILE ?= m68k-atari-mintelf-
CC := $(CROSS_COMPILE)gcc
VASM ?= vasmm68k_mot
BUILD_DIR ?= build/atari/apps
CFLAGS ?= -O2 -g -Wall -Wextra
# Applications use the supplied MiNTLib's default stack ABI and 32-bit int.
# Do not inherit the kernel's -mshort/-mfastcall flags or Pure C libraries.
APP_FLAGS := -std=gnu11 -m68000

APPLICAT_DIR := MagiC/APPS/APPLICAT/SRC
APPLICAT_SOURCES := $(addprefix $(APPLICAT_DIR)/,APPLICAT.C ICONSEL.C ICA_DIAL.C \
  ANW_DIAL.C TYP_DIAL.C ICP_DIAL.C PTH_DIAL.C SPC_DIAL.C READ_INF.C INF.C \
  WINDOWS.C IMPORT/GEMUT_MT.C)
APPLICAT_OBJECTS := $(patsubst $(APPLICAT_DIR)/%.C,$(BUILD_DIR)/applicat/%.o,$(APPLICAT_SOURCES))
MGVIEW_DIR := MagiC/APPS/MGVIEW/SRC
MGVIEW_SOURCES := $(addprefix $(MGVIEW_DIR)/,MGVIEW.C WINDOWS.C MGWIND.C MEMCHAR2.C)
MGVIEW_OBJECTS := $(patsubst $(MGVIEW_DIR)/%.C,$(BUILD_DIR)/mgview/%.o,$(MGVIEW_SOURCES))
MGNOTICE_DIR := MagiC/APPS/MGNOTICE.2/SRC
MGNOTICE_GEMUT_DIR := MagiC/APPS/APPLICAT/SRC/IMPORT
MGNOTICE_SOURCES := $(addprefix $(MGNOTICE_DIR)/,MGNOTICE.C MGNWIND.C \
  OPT_DIAL.C WINDOWS.C)
MGNOTICE_OBJECTS := $(patsubst $(MGNOTICE_DIR)/%.C,$(BUILD_DIR)/mgnotice/%.o,$(MGNOTICE_SOURCES))


.PHONY: all applicat mod-app cmdline showfile limitmem limitmem-test-driver mgclock mgxclock mgxclock-test-driver vfatconf shutdown wbdaemon wbdaemon-test-driver mod-app-test-driver mgview mgnotice mgnotice-test-driver abi-check console-test-driver
all: mod-app
applicat: $(BUILD_DIR)/applicat/APPLICAT.APP $(BUILD_DIR)/applicat/applicat.rsc \
  $(BUILD_DIR)/applicat/applicat.inf
mod-app: $(BUILD_DIR)/mod-app/MOD_APP.TTP
mgview: $(BUILD_DIR)/mgview/MGVIEW.APP
mgnotice: $(BUILD_DIR)/mgnotice/MGNOTICE.APP $(BUILD_DIR)/mgnotice/mgnotice.rsc \
  $(BUILD_DIR)/mgnotice/EDITOBJC.SLB
mgnotice-test-driver: $(BUILD_DIR)/mgnotice/NEOSTART.PRG

cmdline: $(BUILD_DIR)/cmdline/CMDLINE.PRG
showfile: $(BUILD_DIR)/showfile/SHOWFILE.TTP
shutdown: $(BUILD_DIR)/shutdown/SHUTDOWN.PRG
limitmem: $(BUILD_DIR)/limitmem/LIMITMEM.TTP
limitmem-test-driver: $(BUILD_DIR)/limitmem/NEOSTEST.PRG
mgclock: $(BUILD_DIR)/mgclock/MGCLOCK.PRG
mgxclock: $(BUILD_DIR)/mgxclock/MGXCLOCK.PRG
mgxclock-test-driver: $(BUILD_DIR)/mgxclock/NEOSTEST.PRG
vfatconf: $(BUILD_DIR)/vfatconf/VFATCONF.PRG $(BUILD_DIR)/vfatconf/vfatconf.rsc
wbdaemon: $(BUILD_DIR)/wbdaemon/WBDAEMON.PRG
wbdaemon-test-driver: $(BUILD_DIR)/wbdaemon/NEOSTEST.PRG
mod-app-test-driver: $(BUILD_DIR)/mod-app/NEOSTEST.PRG

$(BUILD_DIR)/applicat/%.o: $(APPLICAT_DIR)/%.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(APPLICAT_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/applicat/APPLICAT.APP: $(APPLICAT_OBJECTS) Makefile.apps
	$(CC) $(APP_FLAGS) $(APPLICAT_OBJECTS) $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/mgview/%.o: $(MGVIEW_DIR)/%.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(MGVIEW_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/mgview/MGVIEW.APP: $(MGVIEW_OBJECTS) Makefile.apps
	$(CC) $(APP_FLAGS) $(MGVIEW_OBJECTS) $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

abi-check: $(BUILD_DIR)/abi-check/ABI_CHECK.o

$(BUILD_DIR)/abi-check/ABI_CHECK.o: MagiC/APPS/ABI_CHECK.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"MagiC/APPS/MGVIEW/SRC" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

console-test-driver: $(BUILD_DIR)/console/RUNARG.PRG

$(BUILD_DIR)/console/RUNARG.PRG: scripts/testdata/RUNARG.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS)

$(BUILD_DIR)/mgnotice/%.o: $(MGNOTICE_DIR)/%.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(MGNOTICE_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/mgnotice/GEMUT_MT.o: $(MGNOTICE_GEMUT_DIR)/GEMUT_MT.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(MGNOTICE_GEMUT_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/mgnotice/MGNOTICE.APP: $(MGNOTICE_OBJECTS) \
  $(BUILD_DIR)/mgnotice/GEMUT_MT.o Makefile.apps
	$(CC) $(APP_FLAGS) $(MGNOTICE_OBJECTS) $(BUILD_DIR)/mgnotice/GEMUT_MT.o \
	  $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/mgnotice/mgnotice.rsc: $(MGNOTICE_DIR)/MGNOTICE.RSC
	mkdir -p "$(@D)"
	cp "$<" "$@"

$(BUILD_DIR)/mgnotice/EDITOBJC.SLB: $(BUILD_DIR)/edit-slb/EDITOBJC.SLB
	mkdir -p "$(@D)"
	cp "$<" "$@"

$(BUILD_DIR)/mgnotice/NEOSTART.PRG: MagiC/APPS/MGNOTICE.2/TESTDATA/NEOSTART.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/applicat/applicat.rsc: $(APPLICAT_DIR)/APPLICAT.RSC
	mkdir -p "$(@D)"
	cp "$<" "$@"

$(BUILD_DIR)/applicat/applicat.inf: MagiC/APPS/APPLICAT/BIN/MINIMAL/APPLICAT.INF
	mkdir -p "$(@D)"
	cp "$<" "$@"

$(BUILD_DIR)/mod-app/NEOSTEST.PRG: MagiC/APPS/MOD_APP/TESTDATA/NEOSTEST.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.PRG=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS)

$(BUILD_DIR)/mod-app/MOD_APP.TTP: MagiC/APPS/MOD_APP/MOD_APP.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.TTP=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS)

$(BUILD_DIR)/cmdline/CMDLINE.PRG: MagiC/TOOLS/CMDLINE/SRC/CMDLINE.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/showfile/SHOWFILE.TTP: MagiC/APPS/SHOWFILE/SRC/SHOWFILE.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.TTP=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS)


$(BUILD_DIR)/limitmem/NEOSTEST.PRG: MagiC/APPS/LIMITMEM/TESTDATA/LIMITMEMTEST.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.PRG=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS)
$(BUILD_DIR)/limitmem/LIMITMEM.TTP: MagiC/APPS/LIMITMEM/SRC/LIMITMEM.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.TTP=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS)

$(BUILD_DIR)/mgclock/MGCLOCK.PRG: MagiC/APPS/MGCLOCK/SRC/MGCLOCK.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.PRG=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/mgxclock/MGXCLOCK.PRG: MagiC/APPS/MGXCLOCK/SRC/MGXCLOCK.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.PRG=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/mgxclock/NEOSTEST.PRG: MagiC/APPS/MGXCLOCK/TESTDATA/NEOSTEST.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.PRG=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/vfatconf/VFATCONF.PRG: MagiC/APPS/VFATCONF/SRC/VFATCONF.C MagiC/APPS/VFATCONF/SRC/VFATCONF_GEM.C MagiC/APPS/VFATCONF/SRC/VFATCONF_GEM.H Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -finput-charset=UTF-8 \
	  -MMD -MP -MF "$(@:.PRG=.d)" -x c MagiC/APPS/VFATCONF/SRC/VFATCONF.C \
	  -x c MagiC/APPS/VFATCONF/SRC/VFATCONF_GEM.C -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/vfatconf/vfatconf.rsc: MagiC/APPS/VFATCONF/SRC/VFATCONF.RSC
	mkdir -p "$(@D)"
	cp "$<" "$@"

$(BUILD_DIR)/shutdown/SHUTDOWN.PRG: MagiC/APPS/SHUTDOWN/SRC/SHUTDOWN.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) \
	  -MMD -MP -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/wbdaemon/WBDAEMON.PRG: MagiC/APPS/WBDAEMON/SRC/WBDAEMON.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.PRG=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/wbdaemon/NEOSTEST.PRG: MagiC/APPS/WBDAEMON/TESTDATA/NEOSTEST.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.PRG=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem
-include $(BUILD_DIR)/mod-app/MOD_APP.d
-include $(BUILD_DIR)/cmdline/CMDLINE.d
-include $(BUILD_DIR)/showfile/SHOWFILE.d
-include $(BUILD_DIR)/limitmem/LIMITMEM.d
-include $(BUILD_DIR)/limitmem/NEOSTEST.d
-include $(BUILD_DIR)/mgclock/MGCLOCK.d
-include $(BUILD_DIR)/mgxclock/MGXCLOCK.d
-include $(BUILD_DIR)/mgxclock/NEOSTEST.d
-include $(BUILD_DIR)/vfatconf/VFATCONF.d
-include $(BUILD_DIR)/shutdown/SHUTDOWN.d
-include $(BUILD_DIR)/wbdaemon/WBDAEMON.d
-include $(BUILD_DIR)/wbdaemon/NEOSTEST.d
-include $(APPLICAT_OBJECTS:.o=.d)
-include $(MGVIEW_OBJECTS:.o=.d)
EDIT_SLB_DIR := MagiC/EXTENSIO/EDIT_SLB/SRC
EDIT_SLB_OBJECTS := $(BUILD_DIR)/edit-slb/EDIT_SLB.o $(BUILD_DIR)/edit-slb/EDITOB.o \
  $(BUILD_DIR)/edit-slb/MEMCHAR2.o $(BUILD_DIR)/edit-slb/EDIT_ENTRY.o

.PHONY: edit-slb
edit-slb: $(BUILD_DIR)/edit-slb/EDITOBJC.SLB

$(BUILD_DIR)/edit-slb/%.o: $(EDIT_SLB_DIR)/%.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(EDIT_SLB_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/edit-slb/MEMCHAR2.o: MagiC/APPS/MGVIEW/SRC/MEMCHAR2.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(EDIT_SLB_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/edit-slb/EDIT_ENTRY.o: $(EDIT_SLB_DIR)/EDIT_ENTRY.S Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Felf -m68000 -spaces -o "$@" "$<"

$(BUILD_DIR)/edit-slb/EDITOBJC.elf: $(EDIT_SLB_OBJECTS) $(EDIT_SLB_DIR)/edit_slb.ld Makefile.apps
	$(CC) -nostartfiles -m68000 -Wl,-m,m68kelf,--emit-relocs,-T,$(EDIT_SLB_DIR)/edit_slb.ld \
	  $(EDIT_SLB_OBJECTS) $(LDFLAGS) -o "$@" $(LDLIBS) -lgem -lc -lgcc

$(BUILD_DIR)/edit-slb/EDITOBJC.SLB: $(BUILD_DIR)/edit-slb/EDITOBJC.elf scripts/elf_to_slb.py
	python3 scripts/elf_to_slb.py "$<" "$@"

-include $(BUILD_DIR)/edit-slb/EDIT_SLB.d
-include $(BUILD_DIR)/edit-slb/EDITOB.d
-include $(BUILD_DIR)/edit-slb/MEMCHAR2.d

MGEDIT_DIR := MagiC/APPS/MGEDIT/SRC
MGEDIT_SOURCES := $(addprefix $(MGEDIT_DIR)/,MGEDIT.C MGEDWIND.C OPT_DIAL.C \
  MGEDIT_GEM.C)
MGEDIT_OBJECTS := $(patsubst $(MGEDIT_DIR)/%.C,$(BUILD_DIR)/mgedit/%.o,$(MGEDIT_SOURCES))

.PHONY: mgedit
mgedit: $(BUILD_DIR)/mgedit/MGEDIT.APP $(BUILD_DIR)/mgedit/mgedit.rsc \
  $(BUILD_DIR)/mgedit/EDITOBJC.SLB

$(BUILD_DIR)/mgedit/%.o: $(MGEDIT_DIR)/%.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(MGEDIT_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/mgedit/MGEDIT.APP: $(MGEDIT_OBJECTS) Makefile.apps
	$(CC) $(APP_FLAGS) $(MGEDIT_OBJECTS) $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/mgedit/mgedit.rsc: $(MGEDIT_DIR)/MGEDIT.RSC
	mkdir -p "$(@D)"
	cp "$<" "$@"

$(BUILD_DIR)/mgedit/EDITOBJC.SLB: $(BUILD_DIR)/edit-slb/EDITOBJC.SLB
	mkdir -p "$(@D)"
	cp "$<" "$@"

-include $(MGEDIT_OBJECTS:.o=.d)
-include $(MGNOTICE_OBJECTS:.o=.d)
-include $(BUILD_DIR)/mgnotice/GEMUT_MT.d
-include $(BUILD_DIR)/mgnotice/NEOSTART.d
-include $(BUILD_DIR)/abi-check/ABI_CHECK.d
-include $(BUILD_DIR)/console/RUNARG.d
