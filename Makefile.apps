CROSS_COMPILE ?= m68k-atari-mintelf-
CC := $(CROSS_COMPILE)gcc
VASM ?= vasmm68k_mot
STRIP ?= $(CROSS_COMPILE)strip
BUILD_DIR ?= build/atari/apps
CFLAGS ?= -O2 -g -Wall -Wextra
# Applications use the supplied MiNTLib's default stack ABI and 32-bit int.
# Do not inherit the kernel's -mshort/-mfastcall flags or Pure C libraries.
APP_FLAGS := -std=gnu11 -m68000

APPLICAT_DIR := MagiC/APPS/APPLICAT/SRC
APPLICAT_SOURCES := $(addprefix $(APPLICAT_DIR)/,APPLICAT.C ICONSEL.C ICA_DIAL.C \
  ANW_DIAL.C TYP_DIAL.C ICP_DIAL.C PTH_DIAL.C SPC_DIAL.C READ_INF.C INF.C \
  WINDOWS.C IMPORT/GEMUT_MT.C)
APPLICAT_OBJECTS := $(patsubst $(APPLICAT_DIR)/%.C,$(BUILD_DIR)/applicat/%.o,$(APPLICAT_SOURCES))
MGVIEW_DIR := MagiC/APPS/MGVIEW/SRC
MGVIEW_SOURCES := $(addprefix $(MGVIEW_DIR)/,MGVIEW.C WINDOWS.C MGWIND.C MEMCHAR2.C)
MGVIEW_OBJECTS := $(patsubst $(MGVIEW_DIR)/%.C,$(BUILD_DIR)/mgview/%.o,$(MGVIEW_SOURCES))
MGNOTICE_DIR := MagiC/APPS/MGNOTICE.2/SRC
MGNOTICE_GEMUT_DIR := MagiC/APPS/APPLICAT/SRC/IMPORT
MGNOTICE_SOURCES := $(addprefix $(MGNOTICE_DIR)/,MGNOTICE.C MGNWIND.C \
  OPT_DIAL.C WINDOWS.C)
MGNOTICE_OBJECTS := $(patsubst $(MGNOTICE_DIR)/%.C,$(BUILD_DIR)/mgnotice/%.o,$(MGNOTICE_SOURCES))
MGSEARCH_DIR := MagiC/APPS/MGSEARCH/SRC
MGSEARCH_MYLIBS_DIR := MagiC/LIB/MYLIBS/SRC
MGSEARCH_PATTERN_DIR := $(MGSEARCH_DIR)
MGSEARCH_INCLUDES := -I"$(MGSEARCH_DIR)" -I"$(MGSEARCH_MYLIBS_DIR)" \
  -I"$(MGSEARCH_PATTERN_DIR)"
MGSEARCH_SOURCES := $(addprefix $(MGSEARCH_DIR)/,MGSEARCH.C SEARCH.C SRCH_WIN.C)
MGSEARCH_OBJECTS := $(patsubst $(MGSEARCH_DIR)/%.C,$(BUILD_DIR)/mgsearch/%.o,$(MGSEARCH_SOURCES)) \
  $(BUILD_DIR)/mgsearch/GEMUTILS.o $(BUILD_DIR)/mgsearch/WINDOWS.o \
  $(BUILD_DIR)/mgsearch/PATTERN.o
MGCOPY_DIR := MagiC/APPS/MGCOPY/SRC
MGCOPY_GEMUT_DIR := MagiC/APPS/APPLICAT/SRC/IMPORT
MGCOPY_INCLUDES := -I"$(MGCOPY_DIR)" -I"$(MGCOPY_GEMUT_DIR)"
MGCOPY_SOURCES := $(addprefix $(MGCOPY_DIR)/,MGCOPY.C CPFILES.C BEG_DIAL.C DAT_DIAL.C)
MGCOPY_OBJECTS := $(patsubst $(MGCOPY_DIR)/%.C,$(BUILD_DIR)/mgcopy/%.o,$(MGCOPY_SOURCES)) \
  $(BUILD_DIR)/mgcopy/GEMUT_MT.o
MGFORMAT_DIR := MagiC/APPS/MGFORMAT/SRC
MGFORMAT_GEMUT_DIR := MagiC/APPS/APPLICAT/SRC/IMPORT
MGFORMAT_INCLUDES := -I"$(MGFORMAT_DIR)" -I"$(MGFORMAT_GEMUT_DIR)"
MGFORMAT_SOURCES := $(addprefix $(MGFORMAT_DIR)/,MGFORMAT.C FMT_DIAL.C CPY_DIAL.C FORMAT.C MGFORMAT_WDLG.C)
MGFORMAT_OBJECTS := $(patsubst $(MGFORMAT_DIR)/%.C,$(BUILD_DIR)/mgformat/%.o,$(MGFORMAT_SOURCES)) \
  $(BUILD_DIR)/mgformat/GEMUT_MT.o


.PHONY: all applicat mod-app cmdline mac2st dump fc split showfile limitmem limitmem-test-driver mgclock mgxclock mgxclock-test-driver vfatconf shutdown wbdaemon wbdaemon-test-driver mod-app-test-driver mgview mgnotice mgnotice-test-driver mgsearch mgsearch-test-driver mgcopy mgcopy-test-driver mgformat mgformat-test-driver mgformat-hardware-kit abi-check console-test-driver
all: mod-app
applicat: $(BUILD_DIR)/applicat/APPLICAT.APP $(BUILD_DIR)/applicat/applicat.rsc \
  $(BUILD_DIR)/applicat/applicat.inf
mod-app: $(BUILD_DIR)/mod-app/MOD_APP.TTP
mgview: $(BUILD_DIR)/mgview/MGVIEW.APP
mgnotice: $(BUILD_DIR)/mgnotice/MGNOTICE.APP $(BUILD_DIR)/mgnotice/mgnotice.rsc \
  $(BUILD_DIR)/mgnotice/EDITOBJC.SLB
mgnotice-test-driver: $(BUILD_DIR)/mgnotice/NEOSTART.PRG
mgsearch: $(BUILD_DIR)/mgsearch/MGSEARCH.APP $(BUILD_DIR)/mgsearch/MGSEARCH.RSC
mgsearch-test-driver: $(BUILD_DIR)/mgsearch/NEOSTART.PRG
mgcopy: $(BUILD_DIR)/mgcopy/MGCOPY.APP $(BUILD_DIR)/mgcopy/MGCOPY.RSC
mgcopy-test-driver: $(BUILD_DIR)/mgcopy/NEOSTART.PRG
mgformat: $(BUILD_DIR)/mgformat/MGFORMAT.PRG $(BUILD_DIR)/mgformat/MGFORMAT.RSC
mgformat-test-driver: $(BUILD_DIR)/mgformat/NEOSTART.PRG
mgformat-hardware-kit: mgformat
	rm -rf "$(BUILD_DIR)/mgformat-hardware"
	mkdir -p "$(BUILD_DIR)/mgformat-hardware/ARCHIVE" \
	  "$(BUILD_DIR)/mgformat-hardware/REBUILT"
	cp "$(MGFORMAT_DIR)/../BIN/MGFORMAT.PRG" \
	  "$(BUILD_DIR)/mgformat-hardware/ARCHIVE/MGFORMAT.PRG"
	cp "$(MGFORMAT_DIR)/MGFORMAT.RSC" \
	  "$(BUILD_DIR)/mgformat-hardware/ARCHIVE/MGFORMAT.RSC"
	cp "$(BUILD_DIR)/mgformat/MGFORMAT.PRG" \
	  "$(BUILD_DIR)/mgformat-hardware/REBUILT/MGFORMAT.PRG"
	cp "$(BUILD_DIR)/mgformat/MGFORMAT.RSC" \
	  "$(BUILD_DIR)/mgformat-hardware/REBUILT/MGFORMAT.RSC"
	$(STRIP) -s "$(BUILD_DIR)/mgformat-hardware/REBUILT/MGFORMAT.PRG"
	tar -czf "$(BUILD_DIR)/mgformat-hardware-kit.tar.gz" \
	  -C "$(BUILD_DIR)/mgformat-hardware" .

cmdline: $(BUILD_DIR)/cmdline/CMDLINE.PRG
mac2st: $(BUILD_DIR)/mac2st/MAC2ST.TTP
dump: $(BUILD_DIR)/dump/DUMP.TTP
fc: $(BUILD_DIR)/fc/FC.TTP
split: $(BUILD_DIR)/split/SPLIT.TTP
showfile: $(BUILD_DIR)/showfile/SHOWFILE.TTP
shutdown: $(BUILD_DIR)/shutdown/SHUTDOWN.PRG
limitmem: $(BUILD_DIR)/limitmem/LIMITMEM.TTP
limitmem-test-driver: $(BUILD_DIR)/limitmem/NEOSTEST.PRG
mgclock: $(BUILD_DIR)/mgclock/MGCLOCK.PRG
mgxclock: $(BUILD_DIR)/mgxclock/MGXCLOCK.PRG
mgxclock-test-driver: $(BUILD_DIR)/mgxclock/NEOSTEST.PRG
vfatconf: $(BUILD_DIR)/vfatconf/VFATCONF.PRG $(BUILD_DIR)/vfatconf/vfatconf.rsc
wbdaemon: $(BUILD_DIR)/wbdaemon/WBDAEMON.PRG
wbdaemon-test-driver: $(BUILD_DIR)/wbdaemon/NEOSTEST.PRG
mod-app-test-driver: $(BUILD_DIR)/mod-app/NEOSTEST.PRG

$(BUILD_DIR)/applicat/%.o: $(APPLICAT_DIR)/%.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(APPLICAT_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/applicat/APPLICAT.APP: $(APPLICAT_OBJECTS) Makefile.apps
	$(CC) $(APP_FLAGS) $(APPLICAT_OBJECTS) $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

$(BUILD_DIR)/mgview/%.o: $(MGVIEW_DIR)/%.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(MGVIEW_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/mgview/MGVIEW.APP: $(MGVIEW_OBJECTS) Makefile.apps
	$(CC) $(APP_FLAGS) $(MGVIEW_OBJECTS) $(LDFLAGS) -o "$@" $(LDLIBS) -lgem

abi-check: $(BUILD_DIR)/abi-check/ABI_CHECK.o

$(BUILD_DIR)/abi-check/ABI_CHECK.o: MagiC/APPS/ABI_CHECK.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"MagiC/APPS/MGVIEW/SRC" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

console-test-driver: $(BUILD_DIR)/console/RUNARG.PRG

$(BUILD_DIR)/console/RUNARG.PRG: scripts/testdata/RUNARG.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP \
	  -MF "$(@:.PRG=.d)" -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS)

