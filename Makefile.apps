DIS1_SOURCES := $(addprefix $(DIS_DIR)/DIS1/,DIS1.C DEC.C SHELSORT.C)
DIS1_OBJECTS := $(patsubst $(DIS_DIR)/DIS1/%.C,$(BUILD_DIR)/dis1/%.o,$(DIS1_SOURCES))
DIS2_SOURCES := $(addprefix $(DIS_DIR)/DIS2/,DIS2.C DIS.C DISASS.C)
DIS2_OBJECTS := $(patsubst $(DIS_DIR)/DIS2/%.C,$(BUILD_DIR)/dis2/%.o,$(DIS2_SOURCES))

$(BUILD_DIR)/dis1/%.o: $(DIS_DIR)/DIS1/%.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(DIS_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/dis1/DIS1.TTP: $(DIS1_OBJECTS) Makefile.apps
	$(CC) $(APP_FLAGS) $(DIS1_OBJECTS) $(LDFLAGS) -o "$@" $(LDLIBS)

$(BUILD_DIR)/dis2/%.o: $(DIS_DIR)/DIS2/%.C Makefile.apps
