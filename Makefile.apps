CPX_DIR := MagiC/APPS/CPX
CPX_OBJECTS := $(BUILD_DIR)/cpx/MAGXCONF.o $(BUILD_DIR)/cpx/CPX_ENTRY.o
CPX_TSLICE_OBJECTS := $(BUILD_DIR)/cpx/TSLICE.o $(BUILD_DIR)/cpx/CPX_ENTRY.o

.PHONY: cpx-abi-lint
cpx-abi-lint:
	python3 scripts/cpx_abi_lint.py

$(BUILD_DIR)/cpx/MAGXCONF.o: | cpx-abi-lint
$(BUILD_DIR)/cpx/TSLICE.o: | cpx-abi-lint

$(BUILD_DIR)/cpx/%.o: $(CPX_DIR)/%.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -I"$(CPX_DIR)" \
	  -MMD -MP -MF "$(@:.o=.d)" -x c -c "$<" -o "$@"

$(BUILD_DIR)/cpx/CPX_ENTRY.o: $(CPX_DIR)/cpx_entry.S Makefile.apps
	mkdir -p "$(@D)"
	$(VASM) -Felf -m68000 -spaces -o "$@" "$<"

$(BUILD_DIR)/cpx/MAGXCONF.elf: $(CPX_OBJECTS) $(CPX_DIR)/cpx.ld Makefile.apps
	$(CC) -nostartfiles -m68000 -Wl,-m,m68kelf,--emit-relocs,-T,$(CPX_DIR)/cpx.ld \
	  $(CPX_OBJECTS) $(LDFLAGS) -o "$@" $(LDLIBS) -lgem -lc -lgcc

$(BUILD_DIR)/cpx/MAGXCONF.CPX: $(BUILD_DIR)/cpx/MAGXCONF.elf \
  $(CPX_DIR)/MAGXCONF.HDR scripts/elf_to_cpx.py
	python3 scripts/elf_to_cpx.py "$<" "$(CPX_DIR)/MAGXCONF.HDR" "$@"

$(BUILD_DIR)/cpx/TSLICE.elf: $(CPX_TSLICE_OBJECTS) $(CPX_DIR)/cpx.ld Makefile.apps
	$(CC) -nostartfiles -m68000 -Wl,-m,m68kelf,--emit-relocs,-T,$(CPX_DIR)/cpx.ld \
	  $(CPX_TSLICE_OBJECTS) $(LDFLAGS) -o "$@" $(LDLIBS) -lgem -lc -lgcc

$(BUILD_DIR)/cpx/TSLICE.CPX: $(BUILD_DIR)/cpx/TSLICE.elf \
  $(CPX_DIR)/TSLICE.HDR scripts/elf_to_cpx.py
	python3 scripts/elf_to_cpx.py "$<" "$(CPX_DIR)/TSLICE.HDR" "$@"

$(BUILD_DIR)/wbdaemon/NEOSTEST.PRG: MagiC/APPS/WBDAEMON/TESTDATA/NEOSTEST.C Makefile.apps
	mkdir -p "$(@D)"
	$(CC) $(CPPFLAGS) $(CFLAGS) $(APP_FLAGS) -MMD -MP -MF "$(@:.PRG=.d)" \
	  -x c "$<" -x none $(LDFLAGS) -o "$@" $(LDLIBS) -lgem
-include $(BUILD_DIR)/mod-app/MOD_APP.d
-include $(BUILD_DIR)/cmdline/CMDLINE.d
-include $(BUILD_DIR)/showfile/SHOWFILE.d
